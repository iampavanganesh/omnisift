// ============================================================================
// Omnisift — Prisma Schema (V1)
// Source of truth: PostgreSQL (Supabase). Backend is the only writer.
// Principles: canonical catalog is the primary asset · price history is
// append-only · every listing traces to a seller + a data provider.
// See ARCHITECTURE.md (§7, §8) and SCHEMA_NOTES.md for rationale.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Availability {
  IN_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

enum AlertType {
  ANY_DROP // notify on any price decrease
  BELOW_TARGET // notify when price falls below targetPrice
}

enum NotificationType {
  PRICE_DROP
  ALERT_TRIGGERED
  SYSTEM
}

// ---------------------------------------------------------------------------
// Users  (profile only — Supabase Auth owns credentials)
// id MUST equal auth.users.id (Supabase auth uid). No password stored here.
// ---------------------------------------------------------------------------

model User {
  id        String   @id @db.Uuid // = auth.users.id (set on profile creation)
  email     String   @unique
  fullName  String
  phone            String?
  profileCompleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wishlistItems   WishlistItem[]
  priceAlerts     PriceAlert[]
  affiliateClicks AffiliateClick[]
  notifications   Notification[]
  deviceTokens    DeviceToken[]
  analyticsEvents AnalyticsEvent[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Catalog: Brand · Category · Product · ProductVariant
// The canonical Omnisift product. Provider listings ATTACH to it — they do
// not define it. This catalog is the primary asset.
// ---------------------------------------------------------------------------

model Brand {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique
  slug        String    @unique
  logoUrl     String?
  description String?
  createdAt   DateTime  @default(now())
  products    Product[]

  @@map("brands")
}

model Category {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("categories")
}

model Product {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  normalizedTitle String // cleaned/lowercased — dedup + search matching
  slug            String   @unique // URL-safe identifier for /products/:slug; generated at upsert time (see catalog.prisma.repository.ts)
  brandId         String?  @db.Uuid
  categoryId      String?  @db.Uuid
  primaryImageUrl String?
  images          Json? // string[] of image urls
  specs           Json? // key/value specification map
  rating          Float? // aggregate rating, captured from the provider at acquisition time
  reviewCount     Int? // aggregate review count, same source
  ratingBreakdown Json? // ProviderRatingBar[] — star histogram, e.g. [{stars:5,amount:120}]
  reviews         Json? // ProviderUserReview[] — real written reviews, capped at 20 (see immersive.mapper.ts)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  variants        ProductVariant[]
  listings        ProductListing[]
  priceAlerts     PriceAlert[]
  affiliateClicks AffiliateClick[]
  compareCache    CompareCache[]

  sellerPriceSnapshots SellerPriceSnapshot[]
  productExternalIds   ProductExternalId[]
  
  @@index([normalizedTitle])
  @@index([brandId])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @db.Uuid
  title      String // e.g. "128GB Blue"
  attributes Json? // { storage: "128GB", color: "Blue" }
  createdAt  DateTime @default(now())

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  listings ProductListing[]

  @@index([productId])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Identity chain: Provider (data source) · Seller (store) · ProductListing
// Provider = HOW we acquired data (SerpAPI today).
// Seller   = WHO sells it (Amazon.in, Flipkart, AJIO ...).
// Listing  = this Omnisift product, as offered by a seller.
// Uniqueness (sellerId, sellerProductId) prevents duplicates within a store.
// ---------------------------------------------------------------------------

model Provider {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique // "SerpAPI"
  slug      String   @unique // "serpapi"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  listings     ProductListing[]
  priceHistory PriceHistory[]
  

  @@map("providers")
}

model Seller {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String // "Amazon.in"
  slug      String   @unique // "amazon-in"
  domain    String? // "amazon.in"
  logoUrl   String?
  createdAt DateTime @default(now())

  listings        ProductListing[]
  affiliateClicks AffiliateClick[]
  sellerPriceSnapshots SellerPriceSnapshot[]

  @@map("sellers")
}

model SellerPriceSnapshot {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String       @db.Uuid
  sellerId     String       @db.Uuid
  price        Decimal      @db.Decimal(12, 2)
  mrp          Decimal?     @db.Decimal(12, 2)
  discountPct  Int?
  availability Availability @default(UNKNOWN)
  capturedAt   DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller  Seller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([productId, capturedAt])
  @@index([sellerId, capturedAt])
  @@map("seller_price_snapshots")
}
model ProductListing {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String   @db.Uuid
  variantId       String?  @db.Uuid
  sellerId        String   @db.Uuid
  providerId      String   @db.Uuid
  sellerProductId String? // ASIN / Flipkart id — dedup key within a seller
  productUrl      String // seller product/buy URL
  title           String? // seller's own title for this listing
  imageUrl        String?
  currency        String   @default("INR")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  seller   Seller          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  provider Provider        @relation(fields: [providerId], references: [id], onDelete: Restrict)

  price           Price?
  priceHistory    PriceHistory[]
  affiliateClicks AffiliateClick[]

  @@unique([sellerId, sellerProductId])
  @@index([productId])
  @@index([sellerId])
  @@map("product_listings")
}
model ProductExternalId {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @db.Uuid
  provider   String // 'serpapi' now; 'flipkart','amazon' later
  externalId String // the provider's product id (Google product id for serpapi)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId]) // one internal product per provider id
  @@index([productId])
  @@map("product_external_ids")
}

// ---------------------------------------------------------------------------
// Prices: current offer (mutable, 1:1 listing) + append-only history log
// ---------------------------------------------------------------------------

model Price {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId    String       @unique @db.Uuid
  currentPrice Decimal      @db.Decimal(12, 2)
  mrp          Decimal?     @db.Decimal(12, 2)
  discountPct  Int? // 0–100
  currency     String       @default("INR")
  availability Availability @default(UNKNOWN)
  observedAt   DateTime // when this current price was last seen
  updatedAt    DateTime     @updatedAt

  listing ProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("prices")
}

/// APPEND-ONLY. Every price observation is inserted, never updated or
/// overwritten. A background job trims records older than the rolling window.
/// This accumulated history is the moat.
model PriceHistory {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId    String       @db.Uuid
  providerId   String       @db.Uuid // source of this observation
  price        Decimal      @db.Decimal(12, 2)
  mrp          Decimal?     @db.Decimal(12, 2)
  discountPct  Int?         // 0–100, discount at this observation (for discount-over-time)
  sellerId     String?      @db.Uuid // direct seller link for fast per-store price analytics
  currency     String       @default("INR")
  availability Availability @default(UNKNOWN)
  observedAt   DateTime     @default(now())

  listing  ProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  provider Provider       @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([listingId, observedAt])
  @@index([observedAt])
  @@map("price_history")
}

// ---------------------------------------------------------------------------
// Caches (PostgreSQL-based, no Redis in V1)
// Search: 7-day expiry · Compare: 24-hour expiry
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Search cache — ROWS model (one row per product per query).
// Replaces the old per-page JSON blob. Deduped by (normalizedQuery, productId).
// `refreshedAt` tracks when this query was last hit against the provider — used
// for the 7-day freshness check (fresh -> serve rows, stale -> re-call API).
// `available` supports dead-product handling; `position` preserves show-order.
// ---------------------------------------------------------------------------
model SearchCache {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  normalizedQuery String
  productId       String
  rawQuery        String   @default("")
  data            Json     // full ProviderProduct snapshot
  position        Int?     // ordering within the query's results
  available       Boolean  @default(true)
  refreshedAt     DateTime @default(now()) // last time this query hit the provider
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  @@unique([normalizedQuery, productId])
  @@index([normalizedQuery])
  @@index([normalizedQuery, available])
  @@index([normalizedQuery, refreshedAt])
  @@map("search_cache")
}

model CompareCache {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Cache LOOKUP key = the provider's immersive token (what the app has on tap).
  // Stable enough within the cache window; if it ever rotates, the new token is
  // treated as a new row (fresh fetch) — harmless. Optional/unique.
  token       String?  @unique
  productId   String?  @db.Uuid
  results     Json // snapshot of sellers/prices at compare time
  sellerCount Int      @default(0)
  lowestPrice Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime // createdAt + compare_cache_hours

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("compare_cache")
}

// ---------------------------------------------------------------------------
// User engine: Wishlist · Alerts
// ---------------------------------------------------------------------------

model WishlistItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  productId  String // SerpAPI product id (snapshot key)
  token      String   @default("")
  title      String
  imageUrl   String   @default("")
  price      Decimal  @db.Decimal(12, 2)
  platform   String   @default("")
  productUrl String   @default("")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

model PriceAlert {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @db.Uuid
  productId         String    @db.Uuid
  type              AlertType @default(ANY_DROP)
  targetPrice       Decimal?  @db.Decimal(12, 2) // required for BELOW_TARGET
  isActive          Boolean   @default(true)
  lastTriggeredAt   DateTime?
  lastNotifiedPrice Decimal?  @db.Decimal(12, 2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, type])
  @@index([productId, isActive])
  @@map("price_alerts")
}

// ---------------------------------------------------------------------------
// Affiliate engine: outbound click tracking (monetization)
// ---------------------------------------------------------------------------

model AffiliateClick {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @db.Uuid
  productId        String   @db.Uuid
  listingId        String?  @db.Uuid
  sellerId         String   @db.Uuid
  affiliateNetwork String? // e.g. future partner network
  trackingId       String?
  targetUrl        String
  clickedAt        DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  listing ProductListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  seller  Seller          @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([productId])
  @@index([clickedAt])
  @@map("affiliate_clicks")
}

// ---------------------------------------------------------------------------
// Analytics + Notifications
// analytics userId is NULLABLE — some events fire pre-auth (App Open, Welcome).
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @db.Uuid
  sessionId  String?
  eventName  String
  properties Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventName, createdAt])
  @@index([userId])
  @@map("analytics_events")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType @default(PRICE_DROP)
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}
model DeviceToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique // FCM registration token (one per device)
  platform  String? // 'android' | 'ios' | 'web'
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model PriceSnapshot {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String // SerpAPI product id (denormalized, no FK)
  lowest     Decimal  @db.Decimal(12, 2)
  highest    Decimal  @db.Decimal(12, 2)
  average    Decimal  @db.Decimal(12, 2)
  capturedAt DateTime @default(now())

  @@index([productId, capturedAt])
  @@map("price_snapshots")
}

model ApiUsageLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider      String
  endpoint      String
  feature       String
  query         String?
  userId        String?  @db.Uuid
  cacheHit      Boolean  @default(false)
  success       Boolean  @default(true)
  durationMs    Int?
  resultCount   Int?
  page          Int?
  errorReason   String?
  httpStatus    Int?
  sessionId     String?
  estimatedCost Decimal? @db.Decimal(10, 4)
  createdAt     DateTime @default(now())

  @@index([provider, createdAt])
  @@index([feature, createdAt])
  @@map("api_usage_logs")
}

// ---------------------------------------------------------------------------
// Brand analytics rollup (Layer 2).
// One row per (brand, date). Populated nightly by a pg_cron job that aggregates
// `compare` events from analytics_events. Read this for fast brand stats/trends
// instead of scanning raw events. `brand` is the string from the compare event
// (resolveBrand: brand field -> Brand spec -> first word of title -> "unknown").
// ---------------------------------------------------------------------------
model BrandStatsDaily {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand       String
  date        DateTime @db.Date
  comparisons Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brand, date])
  @@index([date])
  @@map("brand_stats_daily")
}

// ---------------------------------------------------------------------------
// Query analytics rollup (Layer 2 — search volume).
// One row per (query, date). Populated nightly by a pg_cron job that aggregates
// `search` events from analytics_events. Answers "what do users search, how
// often." `query` is lowercased+trimmed so "iPhone"/"iphone " count as one.
// ---------------------------------------------------------------------------
model QueryStatsDaily {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  query     String
  date      DateTime @db.Date
  searches  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([query, date])
  @@index([date])
  @@index([searches])
  @@map("query_stats_daily")
}

// ---------------------------------------------------------------------------
// Runtime config — DB-backed feature flags / tunables, editable from Supabase
// WITHOUT a code change or redeploy. One row per setting (key -> value).
// Read by the backend (cached ~5 min) and exposed via GET /config for the app.
// First key: `max_search_pages` (auto-scroll page cap). Future: price_graph_
// enabled, search_cache_days, compare_cache_hours, etc. Values are stored as
// strings and parsed by the reader — keeps the table dead simple + universal.
// ---------------------------------------------------------------------------
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_config")
}
