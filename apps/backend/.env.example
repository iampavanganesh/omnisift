# ---- App ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated list of allowed origins for browser clients (apps/web, and Flutter
# Web if it ever calls the API from a browser context). Never leave this as the
# default '*' in production — the backend refuses to boot in production with an open
# CORS policy (see bootstrap/app.ts). Example for real deployments:
# CORS_ORIGINS=https://omnisift.com,https://www.omnisift.com
CORS_ORIGINS=*

# ---- Database (Supabase Postgres) ----
DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:<password>@<host>:5432/postgres

# ---- Supabase ----
SUPABASE_URL=https://<project-ref>.supabase.co
# Client-safe key (used by Flutter/browser clients too) — not a secret in the same
# sense as the service-role key below, but still don't commit real values here.
SUPABASE_ANON_KEY=<anon-key>
# NEVER expose this to any client (Flutter, apps/web, browser). Backend-only, always.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_SECRET=<jwt-secret>

# ---- SerpAPI ----
SERPAPI_KEY=<serpapi-key>

# ---- Rate limiting (global throttler — see core/security/security.module.ts) ----
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
